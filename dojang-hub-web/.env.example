# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Base domain for tenant routing / proxy (e.g. localhost:3000 for local development)
NEXT_PUBLIC_BASE_DOMAIN=localhost:3000

# Optional: extra image hosts for next/image (comma-separated base URLs), e.g. a Cloudflare R2
# public bucket. The origin of NEXT_PUBLIC_API_URL + /storage/** is allowed automatically.
# NEXT_PUBLIC_ASSET_HOSTS=https://pub-xxxx.r2.dev
