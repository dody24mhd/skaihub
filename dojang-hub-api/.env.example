# Produksi: lihat docs/DEPLOY.md (APP_ENV=production, APP_DEBUG=false, LOG_LEVEL=warning)
APP_NAME=SKAIHUB
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Frontend & CORS Configuration
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000
# Masa berlaku token API dalam menit (10080 = 7 hari)
SANCTUM_EXPIRATION=10080
# Wajib diisi di produksi: origin web dipisah koma, mis. https://skaihub.com,https://admin.skaihub.com
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=skaihub
DB_USERNAME=postgres
DB_PASSWORD=
# Produksi dengan DB terkelola: require (default config = prefer: pakai TLS bila server mendukung,
# tanpa menolak koneksi plaintext; "require" menolak koneksi tanpa TLS)
# DB_SSLMODE=require
# Alternatif satu baris (mengalahkan DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD;
# ?sslmode= di URL mengalahkan DB_SSLMODE). Neon: pakai host "-pooler" untuk aplikasi:
# DB_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Opsional, hanya dipakai entrypoint Docker untuk `migrate` (Neon: host tanpa "-pooler"):
# DB_MIGRATION_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Disk berkas unggahan: public (lokal, /storage) atau s3 (mis. Cloudflare R2 — isi AWS_* + AWS_URL)
FILESYSTEM_UPLOAD_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@skaihub.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Cloudflare R2: AWS_DEFAULT_REGION=auto, AWS_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com,
# AWS_URL=URL publik bucket (r2.dev atau domain sendiri), AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=
AWS_URL=

VITE_APP_NAME="${APP_NAME}"

# Opsional (middleware admin.api, saat ini tidak dipakai route). Kosong = semua request ditolak.
# Bila dipakai: string acak >= 40 karakter, jangan pakai nilai contoh.
ADMIN_API_TOKEN=

# Hanya untuk membuat super admin pertama: php artisan db:seed --class=SuperAdminSeeder --force
# Jangan biarkan kosong bila di-uncomment (nilai kosong mengalahkan default). Tanpa SUPER_ADMIN_PASSWORD password = "password".
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_NAME=
# SUPER_ADMIN_PASSWORD=

# Di balik load balancer/proxy TLS (Render, dll.): TRUSTED_PROXIES=* (percaya IP pemanggil langsung).
# Kosong = header X-Forwarded-* diabaikan.
TRUSTED_PROXIES=
